# Example terraform.tfvars file
# Copy this to terraform.tfvars and fill in your values

google_cloud_project = "your-gcp-project-id"
region              = "europe-west6"
environment         = "staging"  # or "prod"

# Service configuration
service_name     = "tellme-backend"
sql_instance_name = "tellme-db"
database_name    = "db"

# Storage buckets
media_bucket_suffix          = "media"
call_processing_bucket_suffix = "call-processing"
monitoring_bucket_suffix      = "monitoring"  # staging only

# Other resources
cloud_tasks_queue_name = "tellme-queue"
artifact_repo         = "cloud-run-source-deploy"
monitoring_function   = "tellme-langfuse-exporter"  # staging only

# GitHub Actions integration
workload_identity_provider = "projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/POOL_ID/providers/PROVIDER_ID"
cicd_service_account      = "github-actions@your-project.iam.gserviceaccount.com"